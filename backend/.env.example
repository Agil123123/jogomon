# JOGO-MON Backend — contoh config. Copy ke ../.env (root repo) lalu isi nilai asli.
# JANGAN commit .env yang sudah terisi.

# --- Database ---
DATABASE_URL=postgresql+asyncpg://fams:CHANGEME@localhost:5432/olt_monitoring

# --- Cache ---
REDIS_URL=redis://localhost:6379/1

# --- Auth ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGEME-generate-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- Enkripsi kredensial device (ssh_password / snmp_community) ---
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_KEY=CHANGEME-fernet-key-44-chars-base64

# --- Seed admin awal (dipakai sekali saat startup kalau tabel user kosong) ---
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=CHANGEME

# --- CORS: origin frontend yang diizinkan (comma-separated, TANPA wildcard di prod) ---
CORS_ORIGINS=http://localhost:3100,http://157.15.73.34:3100

# --- Collector ---
POLLING_ENABLED=true
# Maksimum OLT yang dipoll paralel (rate limit ke DB & jaringan)
POLLING_CONCURRENCY=4
SSH_TIMEOUT=15
SNMP_TIMEOUT=5
SNMP_RETRIES=1

# --- Misc ---
LOG_LEVEL=INFO
