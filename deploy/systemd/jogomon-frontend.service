[Unit]
Description=JOGO-MON Frontend (Next.js)
After=network.target jogomon-backend.service

[Service]
Type=simple
User=jogomon
Group=jogomon
WorkingDirectory=/opt/jogomon/frontend
Environment="NODE_ENV=production"
ExecStart=/usr/bin/npm start -- -H 127.0.0.1 -p 3100
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target